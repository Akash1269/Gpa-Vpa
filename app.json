{
  "expo": {
    "name": "GPA-VPA",
    "slug": "gpa-calculator",
    "version": "0.1.3",
    "runtimeVersion": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gpavpa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akash1269.gpavpa",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.akash1269.gpavpa",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3B5BDB"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B5BDB",
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#1F2A6B",
            "image": "./assets/images/adaptive-icon.png"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "extraProguardRules": "-dontobfuscate"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Gpa-Vpa"
    },
    "extra": {
      "eas": {
        "projectId": "cdc61fa1-5392-47ce-a861-ce415358623e"
      },
      "router": {}
    },
    "owner": "akash1269"
  }
}
